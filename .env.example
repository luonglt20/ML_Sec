# Copy this file to .env and fill in the key(s) for whichever model(s)
# your RunConfig names. Both the CLI and the demo UI load .env
# automatically (see README.md); a value already exported in your shell
# always takes precedence over the .env entry of the same name.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Copy this file to .env and fill in your actual API keys.
# The application automatically loads .env at runtime.
# DO NOT commit your actual .env file with real secrets to Git.

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq API Keys (Supports rotating multiple keys)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here

# Google Gemini API Keys (Supports rotating multiple keys)
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Model Selection Tiers
GROQ_LIGHT_MODEL=llama-3.1-8b-instant
GROQ_STRONG_MODEL=llama-3.3-70b-versatile

GEMINI_LIGHT_MODEL=gemini-2.0-flash-lite
GEMINI_STRONG_MODEL=gemini-2.5-flash

DEEPSEEK_LIGHT_MODEL=deepseek-chat
DEEPSEEK_STRONG_MODEL=deepseek-reasoner

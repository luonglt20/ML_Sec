{
  "model": "deepseek-chat",
  "temperature": 0.0,
  "dev_sample_size": 3,
  "official_test_sample_size": 3,
  "seed": 42,
  "rag_top_k": 3,
  "rag_chunk_size": 256,
  "rag_child_chunk_size": 64,
  "rag_parent_chunk_size": 512,
  "rag_max_passage_tokens": 200,
  "rag_retrieval_buffer": 2,
  "rag_use_hybrid": true,
  "rag_use_hyde": true,
  "rag_relevance_threshold": 0.015,
  "rag_max_retrieval_loops": 2,
  "rag_enable_backtracking": true,
  "rag_enable_debate": true,
  "rag_use_multi_query": true,
  "rag_use_option_boosting": true,
  "rag_option_boost_weight": 0.05,
  "rag_dynamic_top_k": true,
  "rag_heuristic_compression": true,
  "rag_adaptive_routing": true,
  "memory_top_k": 3,
  "rag_index_dir": "data/rag_index"
}
